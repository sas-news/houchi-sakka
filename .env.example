# 放置作家 — 環境変数の雛形。実値はコミットしないこと。

# --- apps/web (Cloudflare Workers) ---
# wrangler dev / vite dev では apps/web/.dev.vars に同じ名前で置く。
# AES-256-GCM の鍵 (base64 の 32 バイト)。生成: openssl rand -base64 32
APP_SECRET_KEY=
# 実行体(Runner)と共有する Bearer トークン。
EXECUTOR_TOKEN=

# OAuth ログイン (better-auth)。未設定ならそのボタンは出ない。
# Google Cloud Console → OAuth クライアント (Web) → 承認済みリダイレクト URI:
#   https://<host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → Callback URL:
#   https://<host>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 開発用ワンクリックログイン (固定ユーザー dev@houchi-sakka.local)。
# ローカル開発・CI のみ。"true" を本番環境変数に絶対に入れないこと —
# 誰でも /api/dev/login を叩いてログインできてしまう。
DEV_LOGIN_ENABLED=

# orchestrator_turn の既定モデル (メッセージ送信時に model 未指定の場合)
DEFAULT_MODEL=gpt-4o-mini

# --- apps/runner ---
# Web API のベース URL (ローカル: http://localhost:8787)
WEB_BASE_URL=http://localhost:8787
# apps/web の EXECUTOR_TOKEN と同じ値
EXECUTOR_TOKEN=
# リースのポーリング間隔 (ミリ秒)
POLL_INTERVAL_MS=2000
# リース保持時間 (ミリ秒)。provider 呼び出しが長い場合は大きめに。
LEASE_TTL_MS=120000
# 実行体 ID (未指定なら hostname+pid)
EXECUTOR_ID=
# provider: openai | stub (stub はローカルスモーク用、キー不要)
RUNNER_PROVIDER=stub
# --env-key モード時に使う OpenAI キー (本番は key_ref 経由で DB から取る)
OPENAI_API_KEY=

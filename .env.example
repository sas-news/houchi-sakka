# 放置作家 Phase 0 — 環境変数の雛形。実値はコミットしないこと。

# --- apps/web (Cloudflare Workers) ---
# wrangler dev では apps/web/.dev.vars に同じ名前で置く。
# AES-256-GCM の鍵 (base64 の 32 バイト)。生成: openssl rand -base64 32
APP_SECRET_KEY=
# 実行体(Runner)と共有する Bearer トークン。
EXECUTOR_TOKEN=

# --- apps/runner ---
# Web API のベース URL (ローカル: http://localhost:8787)
WEB_BASE_URL=http://localhost:8787
# apps/web の EXECUTOR_TOKEN と同じ値
EXECUTOR_TOKEN=
# リースのポーリング間隔 (ミリ秒)
POLL_INTERVAL_MS=2000
# リース保持時間 (ミリ秒)。provider 呼び出しが長い場合は大きめに。
LEASE_TTL_MS=120000
# 実行体 ID (未指定なら hostname+pid)
EXECUTOR_ID=
# provider: openai | stub (stub はローカルスモーク用、キー不要)
RUNNER_PROVIDER=stub
# --env-key モード時に使う OpenAI キー (本番は key_ref 経由で DB から取る)
OPENAI_API_KEY=

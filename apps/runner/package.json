{
  "name": "@houchi/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "houchi-runner": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@houchi/contracts": "workspace:*",
    "@houchi/harness": "workspace:*",
    "@houchi/providers": "workspace:*"
  },
  "devDependencies": {
    "@houchi/database": "workspace:*",
    "@houchi/web": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.44.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
